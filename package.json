{
    "name": "monopolyclient",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite src/client",
        "build": "tsc -p src/client/tsconfig.json && vite build src/client",
        "build:backend": "tsc -p src/server/tsconfig.json && node -e \"require('fs').writeFileSync('dist-backend/package.json', JSON.stringify({type: 'commonjs'}))\"",
        "lint": "eslint src/client/src src/server/src src/shared --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"*.{js,cjs,json}\"",
        "type-check": "tsc -p src/client/tsconfig.json --noEmit && tsc -p src/server/tsconfig.json --noEmit",
        "preview": "vite preview src/client",
        "start": "npm run build:backend && node dist-backend/src/server/src/index.js"
    },
    "dependencies": {
        "@types/crypto-js": "^4.2.2",
        "@types/ws": "^8.5.5",
        "crypto-js": "^4.2.0",
        "express": "^4.18.2",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-router-dom": "^6.16.0",
        "ws": "^8.13.0"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/react": "^18.0.37",
        "@types/react-dom": "^18.0.11",
        "@typescript-eslint/eslint-plugin": "^5.59.0",
        "@typescript-eslint/parser": "^5.59.0",
        "@vitejs/plugin-basic-ssl": "^1.0.1",
        "@vitejs/plugin-react": "^4.0.0",
        "eslint": "^8.38.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-react-refresh": "^0.3.4",
        "prettier": "^3.8.4",
        "typescript": "^5.0.2",
        "vite": "^4.3.9"
    }
}
